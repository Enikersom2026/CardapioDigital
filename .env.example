# GEMINI_API_KEY: Chave da API do Google Gemini para geração e aprimoramento de pratos via IA.
# No Netlify: adicione em Site settings > Environment variables
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# APP_URL: URL base pública onde o sistema está hospedado (ex: https://domgabriel.netlify.app)
APP_URL="https://seu-app.netlify.app"

# PORT: Porta do servidor Express local (padrão: 3000)
PORT=3000

# FIREBASE CONFIGURATION (Opcional - caso queira conectar seu próprio projeto Firebase)
# Se não fornecidas, o app utiliza a conexão padrão pré-configurada do Dom Gabriel.
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
